material 1
# What a transparent material's draws draw with while its pipelines compile: a grey, half-opaque, lit surface, without
# parameters, so it reads none of the draw's block (see docs/rendering/materials.md#runtime).
shading = lit
blend = transparent
---
Surface evaluate(Material_Inputs inputs) {
	Surface s = default_surface();
	s.base_color = float3(0.8, 0.8, 0.8);
	s.roughness = 0.6;
	s.opacity = 0.5;
	return s;
}
