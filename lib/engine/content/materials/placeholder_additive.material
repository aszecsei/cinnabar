material 1
# What an additive material's draws draw with while its pipelines compile: a dim grey glow, without parameters, so it
# reads none of the draw's block (see docs/rendering/materials.md#runtime).
shading = unlit
blend = additive
---
Surface evaluate(Material_Inputs inputs) {
	Surface s = default_surface();
	s.color = float3(0.2, 0.2, 0.2);
	s.opacity = 1;
	return s;
}
