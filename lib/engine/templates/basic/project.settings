# The project's settings (see docs/overview/architecture.md#project-settings). The editor edits them, and a running game takes
# a change at once. project.user.settings beside this file replaces them on one machine, and is not committed.

# The game's name, which the release's executable and window take.
game.name = {{name}}

# The scene that the game starts with, by GUID: content/scenes/main.scene.
game.main_scene = {{guid:content/scenes/main.scene}}

# The release executable's icon: a .ico file, relative to this file.
game.icon = icon.ico

# The window's output mode: Auto (HDR10 on a display in HDR, SDR otherwise), Sdr, Hdr10 or Scrgb.
output = Auto

# The material of new faces in the editor's mesh mode: a material or an instance by GUID. The engine's dev_gray.
mesh.default_material = 5a1c3e7f9b2d4f608a1c3e5f7a9b0c2d
