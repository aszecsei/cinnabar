package script

import "base:runtime"
import "core:fmt"
import "core:reflect"
import "core:slice"
import "core:strings"

import "cinnabar:core"
import "cinnabar:engine/ecs"

// The types of the engine's API. definitions adds the parts that depend on the game.
ENGINE_DEFINITIONS :: #load("engine.d.luau", string)

MAX_DEFINED :: 1024

// Defined records a binding that define set as a global, so definitions can declare its type. Registrations, like
// bindings: reload clears them.
@(private)
Defined :: struct {
	name:      string,
	signature: string,
	// The engine's own bindings are in engine.d.luau.
	engine:    bool,
}

@(private)
record_defined :: proc(r: ^Runtime, name, signature: string) {
	if r.defined_count == MAX_DEFINED {
		return
	}
	r.defined[r.defined_count] = {name, signature, r.defining_engine}
	r.defined_count += 1
}

// definitions writes a Luau definition file for the runtime's globals: the engine's API, Entity with a typed get and
// add for each exposed component, Key, each exposed component, and the game's bindings with the signatures that it
// gave define. tools/cook type checks against it, and luau-lsp reads it. See docs/scripting.md#types-and-tooling.
definitions :: proc(r: ^Runtime, allocator: runtime.Allocator) -> string {
	b := strings.builder_make(allocator)
	strings.write_string(&b, "-- Generated by host.exe --emit-script-types from the game's bindings. Do not edit.\n\n")
	strings.write_string(&b, ENGINE_DEFINITIONS)

	strings.write_string(&b, "\n-- The exposed components.\n")
	for &x in r.exposed[:r.exposed_count] {
		name := exposed_name(&x)
		fmt.sbprintf(&b, "\ndeclare extern type %sType extends ComponentType with\nend\n\ndeclare %s: %sType\n", name, name, name)
		if x.id == ecs.TRANSFORM_ID {
			continue
		}
		fmt.sbprintf(&b, "\ndeclare extern type %sRef extends ComponentRef with\n", name)
		for &f in r.fields[x.first_field:][:x.field_count] {
			fmt.sbprintf(&b, "\t%s: %s\n", f.name, field_type(&f, allocator))
		}
		strings.write_string(&b, "end\n")
	}

	// get and add are overloaded: a component type gives its reference, and a behaviour class gives an instance.
	get, add := strings.builder_make(allocator), strings.builder_make(allocator)
	for &x in r.exposed[:r.exposed_count] {
		name := exposed_name(&x)
		ref := x.id == ecs.TRANSFORM_ID ? "TransformRef" : fmt.aprintf("%sRef", name, allocator = allocator)
		fmt.sbprintf(&get, "((Entity, %sType) -> %s?) & ", name, ref)
		fmt.sbprintf(&add, "((Entity, %sType, {{ [string]: any }}?) -> %s) & ", name, ref)
	}
	strings.write_string(&get, "((Entity, { [any]: any }) -> any)")
	strings.write_string(&add, "((Entity, { [any]: any }, { [string]: any }?) -> any)")
	fmt.sbprintf(&b, ENTITY_DEFINITION, strings.to_string(get), strings.to_string(add))

	strings.write_string(&b, "\ndeclare Key: {\n")
	for name, i in reflect.enum_field_names(core.Key) {
		if i > 0 {
			buffer: [32]u8
			fmt.sbprintf(&b, "\t%s: number,\n", script_name(name, buffer[:]))
		}
	}
	strings.write_string(&b, "}\n")

	write_game_bindings(r, &b, allocator)
	return strings.to_string(b)
}

@(private = "file")
ENTITY_DEFINITION :: `
declare extern type Entity with
	transform: TransformRef?
	parent: Entity?
	active_self: boolean
	active_in_hierarchy: boolean
	get: %s
	add: %s
	function has(self, component: any): boolean
	function remove(self, component: any): boolean
	function destroy(self): ()
	function is_alive(self): boolean
	function teleport(self, position: WorldPosition, rotation: Quaternion?): ()
	function offset_to(self, other: Entity): vector
	function move(self, offset: vector): ()
	function set_parent(self, parent: Entity?): ()
	function set_active(self, active: boolean): ()
	function send(self, name: string, ...: any): ()
end
`

@(private = "file")
field_type :: proc(f: ^Field, allocator: runtime.Allocator) -> string {
	switch f.kind {
	case .F32, .F64, .I8, .I16, .I32, .I64, .U8, .U16, .U32, .U64:
		return "number"
	case .Bool:
		return "boolean"
	case .Enum:
		// A union of the value names, so a typo is a type error.
		names := make([]string, len(reflect.enum_field_names(f.info.id)), allocator)
		for name, i in reflect.enum_field_names(f.info.id) {
			names[i] = fmt.aprintf("%q", name, allocator = allocator)
		}
		return strings.join(names, " | ", allocator)
	case .Vector:
		return "vector"
	case .Quaternion:
		return "Quaternion"
	case .Position:
		return "WorldPosition"
	case .Entity:
		return "Entity?"
	}
	return "any"
}

// write_game_bindings declares the game's own bindings: a global function, or a field of a library table.
@(private = "file")
write_game_bindings :: proc(r: ^Runtime, b: ^strings.Builder, allocator: runtime.Allocator) {
	game := make([dynamic]Defined, allocator)
	for d in r.defined[:r.defined_count] {
		if !d.engine {
			append(&game, d)
		}
	}
	if len(game) == 0 {
		return
	}
	slice.sort_by(game[:], proc(a, b: Defined) -> bool {return a.name < b.name})
	strings.write_string(b, "\n-- The game's bindings.\n")
	library := ""
	for d in game {
		signature := d.signature != "" ? d.signature : "(...any) -> ...any"
		dot := strings.last_index_byte(d.name, '.')
		if dot < 0 {
			if library != "" {
				strings.write_string(b, "}\n")
				library = ""
			}
			fmt.sbprintf(b, "\ndeclare %s: %s\n", d.name, signature)
			continue
		}
		if d.name[:dot] != library {
			if library != "" {
				strings.write_string(b, "}\n")
			}
			library = d.name[:dot]
			fmt.sbprintf(b, "\ndeclare %s: {{\n", library)
		}
		fmt.sbprintf(b, "\t%s: %s,\n", d.name[dot + 1:], signature)
	}
	if library != "" {
		strings.write_string(b, "}\n")
	}
}
