#usda 1.0
(
    doc = """Intel's PBR Sponza, from samples/intel/downloads/main_sponza.zip, which `just intel-unpack` unpacks
    (see samples/intel/README.md). Only the root layer's upAxis and metersPerUnit count, so they are restated here."""
    subLayers = [@../.unpacked/main_sponza/NewSponza_Main_USD_Yup_003.usda@]
    upAxis = "Y"
    metersPerUnit = 0.01
    defaultPrim = "root"
)

# The sky. Sponza's download has its HDR image but no dome light, so this one draws it.
def Xform "Environment"
{
    def DomeLight "domelight"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @../.unpacked/main_sponza/textures/kloppenheim_05_4k.hdr@
    }
}
