	offset = [0, 1.1, 0]
	rotation = [0, 0, 0, 1]
	scale = [1, 2.2, 0.08]
component 4 Previous_Transform
component 33 Mesh_Renderer
	mesh = $89fc38c8aa19f0cf0cc161d2ab5e015b
	materials.0 = $cbeb3ff7d07840a7a816ea35868ee5b0
	cast_shadows = true
component 64 Rigid_Body
	motion = Kinematic
component 65 Collider
behaviour 85f762623d3e4026b8a86e287b667274

