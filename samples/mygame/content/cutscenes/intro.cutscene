cutscene 1
# The sample's intro (see docs/content/kinds/cutscenes.md): the animation scene's walking fox walks 4 m, past a guard
# that the cutscene spawns, to a bark, after the fox_walk shot, while the running fox runs 6 m beside it and a stone that
# the cutscene spawns rolls away from the guard as it barks. Times are ticks, 60000 a second. The fox's track is
# relative, so it walks from where it stands, and its walk clip loops in place while that track moves it. The shot, which
# the intro binds to the fox, turns the fox to its path as the intro begins. Three spawned shot cameras cut the scene: a
# wide shot that blends in from gameplay, a close shot that racks its focus, and a tracking shot that blends back out.
# Music swells under it and plays on into gameplay, a line of dialogue plays over the wide shot, and the guard's bark is
# heard where the guard stands. A story track tells every behaviour when the guard barks, and that the intro was seen,
# also when it is skipped. The shot fades the intro in from black, letterbox bars slide in and out again as gameplay
# comes back, and a subtitle shows the line of dialogue. While it plays, it pushes the cutscene input context, in which
# the player can hold the skip action, and hides the HUD.
length = 720000
# The range ends at 10 s. The music runs 2 s past it, into gameplay.
range = [0, 600000]
rate = 30
clock = game
# A skip fades to black over a quarter of a second, and back from it over gameplay.
skip_fade = 15000
skip_color = "#000000"
input_context = "cutscene"
hide_ui = [$bdeaa563d6faa121b2f06fde16f065e5]

binding 1 "Walking Fox"
	possess = @f496b929575035d9c2626ed56d3165ba/79cea6d7586e3f48
	policy = required
binding 2 "Extra Guard"
	spawn = $0d9b84a2116a5529c2cd33741edd33a4
	position = [150000000002, 0, 1.5]
	rotation = [0, 0.7071068, 0, 0.7071068]
binding 3 "Wide Shot"
	spawn = $7fb86acbe194450180b90ee9fb0ecf42
	position = [149999999998, 1.6, -5]
binding 4 "Close Shot"
	spawn = $7fb86acbe194450180b90ee9fb0ecf42
	position = [150000000003, 1.2, 2.5]
	rotation = [0, 1, 0, 0]
binding 5 "Tracking Shot"
	spawn = $7fb86acbe194450180b90ee9fb0ecf42
	position = [150000000002, 1.2, -3]
binding 6 "Running Fox"
	# Optional, so the intro plays in a scene without it.
	possess = @f496b929575035d9c2626ed56d3165ba/76b64f812f12cecf
	policy = optional
binding 7 "Stone"
	spawn = $9a2728bfc2e9b1d21ce27d2eb945c856
	position = [150000000002.5, 0.12, 1.2]

track 1 transform "Fox walks"
	binding = 1
	when_finished = keep
	section 1 0 600000
		ease_in = 15000
		channel position_x
			key 0 0 linear
			key 600000 4 linear
track 2 animation "Fox walk clip"
	binding = 1
	section 2 0 600000
		ease_in = 15000
		ease_out = 15000
		asset = $dea303d3f0374a9e56b0bb58f4a85315
		loop = true
		root_motion = in_place
track 3 audio "Bark"
	# The bark plays at the guard, on the Sfx bus, heard to 30 m.
	binding = 2
	section 3 360000 420000
		asset = $7ce894b4b95e68b918869459e5cd9c93
		bus = 2
		min_distance = 2
		max_distance = 30
track 4 sub_sequence "Opening shot"
	# The shot's walker is the fox.
	section 4 0 300000
		asset = $497bcb7bb533b902877cd8d56fbf97cd
		bind 1 = 1
track 5 camera_cut "Cuts"
	# A wide shot blends in from gameplay and looks at the fox, focused on it.
	section 5 0 200000
		camera = 3
		blend_in = 30000 smooth
		look_at = 1
		look_at_offset = [0, 0.5, 0]
		focus = 1
	# A close shot turns to the fox as it passes, while Rack focus pulls the focus in.
	section 6 200000 400000
		camera = 4
		look_at = 1
		look_at_offset = [0, 0.5, 0]
		look_at_damping = 12000
	# A tracking shot follows the fox and blends back to gameplay, at the end or on a skip.
	section 7 400000 600000
		camera = 5
		follow = 1
		follow_offset = [1.5, 1.2, -3]
		look_at = 1
		look_at_offset = [0, 0.5, 0]
		blend_out = 60000 smooth
		blend_on_skip = true
track 6 property "Rack focus"
	binding = 4
	component = 160
	field = "focus_distance"
	section 8 200000 400000
		channel value
			key 0 6 auto
			key 120000 1.5 auto
track 7 audio "Music"
	# The ambience loops on the Music bus, swells as the close shot starts, and plays on into gameplay at a skip and past
	# the end, where it fades out over its ease out.
	section 9 0 720000
		asset = $ac87e25625175689bc0e47ad70107ebe
		bus = 1
		loop = true
		plays_through_skip = true
		ease_in = 60000
		ease_out = 120000
		channel gain
			key 0 0.6 auto
			key 200000 1 auto
			key 400000 0.8 auto
track 8 audio "Dialogue"
	# A line over the wide shot, on Master.
	section 10 30000 174000
		asset = $cde14b9399a74a289146a8362e6a9a9e
track 9 event "Story"
	# Every behaviour with on_guard_bark_begin and on_guard_bark_end hears the bark start and end.
	range 2 360000 420000 guard_bark
	# On the last frame, or at a skip: a script can open the gate that the intro leads to.
	trigger 1 600000 intro_seen
		fire_when_skipped = true
		value = entity 1
track 10 presentation "Presentation"
	# Bars at 2.39 slide in over half a second, and out over the last second, as the tracking shot blends back to
	# gameplay.
	section 12 0 600000
		kind = letterbox
		ease_in = 30000
		ease_out = 60000
		channel aspect
			key 0 2.39 constant
	# The line of dialogue, which moves with its sound.
	section 13 30000 174000
		kind = subtitle
		speaker = "Narrator"
		text = "The fox walks this path every evening."
		key = "intro.narrator.path"
		audio = 10
track 11 transform "Fox runs"
	# The running fox runs on from where it stands, along its own forward, its z, and is back there when the intro ends.
	binding = 6
	section 14 0 600000
		channel position_z
			key 0 0 linear
			key 600000 6 linear
track 12 transform "Stone rolls"
	# Kicked by the bark, the stone rolls 1.5 m, two turns of its 0.12 m radius.
	binding = 7
	section 15 360000 480000
		channel position_x
			key 0 0 auto
			key 120000 1.5 auto
		channel rotation_z
			key 0 0 auto
			key 120000 -716 auto
