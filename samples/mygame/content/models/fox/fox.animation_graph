animation_graph 1
# The animation scene's walking fox (see docs/content/kinds/animation-graphs.md). It looks about while it stands, walks
# and runs by its speed in meters a second, and stops to look about once on the look trigger. The Fox's clips are in
# place, so the graph names no root motion joint: fox_walker.luau moves the fox by its speed. The footsteps are when
# each hind foot is lowest.
entry = idle

param speed float 0
param look trigger

clip survey = $3918fb8bad25fb7d58abb5d2a6f2cadd
clip walk = $dea303d3f0374a9e56b0bb58f4a85315
	event 0.12 footstep "right"
	event 0.61 footstep "left"
clip run = $cf6a8cd8cc1591bd3e6e09437d5754a1
	event 0.02 footstep "left"
	event 0.15 footstep "right"

node 1 state
	position = [0, 0]
	name = idle
	motion = survey
node 2 state
	position = [400, 0]
	name = move
	motion = @10.pose
	enter_event = started
node 3 state
	position = [400, 200]
	name = look
	motion = survey
	loop = false
	enter_event = looking
	exit_event = looked

node 10 blend_1d
	position = [400, -130]
	parameter = speed
	input.0 = walk
	at.0 = 1
	input.1 = run
	at.1 = 3

node 20 transition
	from = idle
	to = move
	when = speed > 0.1
	duration = 0.3
node 21 transition
	from = move
	to = idle
	when = speed < 0.05
	duration = 0.4
node 22 transition
	from = move
	to = look
	when = look
	duration = 0.25
node 23 transition
	from = look
	to = idle
	exit_time = 0.9
	duration = 0.4
