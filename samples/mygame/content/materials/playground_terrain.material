material 1
# The playground's terrain (see docs/editor/landscape.md#the-sample): a 64 m surface that rises 8 m, with four layers,
# grass, dirt, rock and snow, blended by the weights of a layer map's red, green, blue and alpha, and rock on its steep
# slopes. Its height map is the surface's height_map, which the Landscape tool sculpts and its Height_Field collider
# walks on, so height_scale is its height_range's top, and its layer map is the surface's layer_map, which the tool's
# Paint brush paints. size is the Surface_Renderer's size in meters, which the slope needs per texel.
shading = lit
geometry = patches
param height texture = $edfabe6cd1d243218c8ce53e5023c362
param height_scale float = 8
param size float = 64
param layers texture = $7efe47a9d6ce4dbb9c3f07f3a0968784
param grass color = [0.18, 0.3, 0.1, 1]
param dirt color = [0.4, 0.3, 0.2, 1]
param rock color = [0.35, 0.32, 0.3, 1]
param snow color = [0.9, 0.92, 0.95, 1]
---
float terrain_height(float2 uv) {
	return cn_sample_level(params.height, uv, 0).r * params.height_scale;
}

float3 displace(Vertex_Inputs v) {
	return float3(0, terrain_height(v.uv0), 0);
}

Surface evaluate(Material_Inputs inputs) {
	Surface s = default_surface();
	uint width, height;
	cn_texture(params.height).GetDimensions(width, height);
	float2 texel = 1.0 / float2(width, height);
	float2 uv = inputs.uv0;
	float dx = terrain_height(uv + float2(texel.x, 0)) - terrain_height(uv - float2(texel.x, 0));
	float dz = terrain_height(uv + float2(0, texel.y)) - terrain_height(uv - float2(0, texel.y));
	float2 slope = float2(dx, dz) / (2 * texel * params.size);
	// The patch's tangent frame is its x, its z and up.
	s.normal = normalize(float3(-slope, 1));
	float steep = 1 - s.normal.z;
	// The layers' weights, which need not add up to 1.
	float4 w = cn_sample(params.layers, uv);
	float3 layered = (w.r * params.grass.rgb + w.g * params.dirt.rgb + w.b * params.rock.rgb + w.a * params.snow.rgb) / max(dot(w, 1), 1e-3);
	s.base_color = lerp(layered, params.rock.rgb, smoothstep(0.35, 0.6, steep));
	s.roughness = 0.9;
	return s;
}
