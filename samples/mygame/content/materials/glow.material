material 1
# A color that glows as it is, unlit: the Cornell box's light panel.
shading = unlit
param color color = [1, 0.85, 0.65, 1]
# Its brightness in stops: the color times 2^ev (see docs/rendering/materials.md#shading-models).
param ev float = 3
---
Surface evaluate(Material_Inputs inputs) {
	Surface s = default_surface();
	s.color = params.color.rgb * exp2(params.ev);
	return s;
}
