<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cinnabar.Editor.Link</RootNamespace>
    <!-- Written by just link-schema. The generator reports a missing file. -->
    <LinkSchema>$(MSBuildThisFileDirectory)..\..\..\build\link\link-schema.json</LinkSchema>
    <CookSchema>$(MSBuildThisFileDirectory)..\..\..\build\link\cook-schema.json</CookSchema>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cinnabar.Editor.Link.Generator\Cinnabar.Editor.Link.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(LinkSchema)" Condition="Exists('$(LinkSchema)')" />
    <AdditionalFiles Include="$(CookSchema)" Condition="Exists('$(CookSchema)')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cinnabar.Editor.Tests" />
  </ItemGroup>
</Project>
