<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="#1B1B1D" />
    </Style>

    <!-- Ribbon (docs/editor/shell-and-panels.md#ribbon). Its button brushes are in Ribbon/RibbonResources.axaml. -->
    <Style Selector="DockPanel.ribbon">
        <Setter Property="Background" Value="#232326" />
    </Style>
    <Style Selector="DockPanel.ribbon-header">
        <Setter Property="Background" Value="#1D1D20" />
    </Style>
    <Style Selector="Border.ribbon-category">
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Border.ribbon-category > TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ribbon-tab">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#B8B8BE" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.ribbon-tab.selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#232326" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.ribbon-tab.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Background" Value="#232326" />
    </Style>
    <Style Selector="ToggleButton.ribbon-collapse">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ribbon-body">
        <Setter Property="Height" Value="96" />
        <Setter Property="BorderBrush" Value="#333337" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.ribbon-group">
        <Setter Property="Padding" Value="4,4,4,2" />
        <Setter Property="BorderBrush" Value="#38383C" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="TextBlock.ribbon-group-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#8A8A90" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector=":is(Button).ribbon-large, SplitButton.ribbon-large">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MaxWidth" Value="96" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector=":is(Button).ribbon-small">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.ribbon-choice">
        <Setter Property="Margin" Value="6,6,6,0" />
    </Style>
    <Style Selector="StackPanel.ribbon-choice TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Console -->
    <Style Selector="ListBox.console">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.console ListBoxItem">
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="SelectableTextBlock.debug">
        <Setter Property="Foreground" Value="#808088" />
    </Style>
    <Style Selector="SelectableTextBlock.warning">
        <Setter Property="Foreground" Value="#E8B04A" />
    </Style>
    <Style Selector="SelectableTextBlock.error">
        <Setter Property="Foreground" Value="#F0605A" />
    </Style>

    <!-- Outliner -->
    <Style Selector="TextBox.outliner-filter">
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.outliner">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.outliner ListBoxItem">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Properties -->
    <Style Selector="StackPanel.properties">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.properties-header">
        <Setter Property="Margin" Value="4,2,4,4" />
    </Style>
    <Style Selector="StackPanel.properties-header TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="StackPanel.properties-header TextBlock.title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Expander.component">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,6,10,8" />
    </Style>
    <Style Selector="Expander.component /template/ ToggleButton#ExpanderHeader">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Grid.fields">
        <Setter Property="RowSpacing" Value="4" />
        <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.fields TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.field-name">
        <Setter Property="Foreground" Value="#A0A0A8" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MaxWidth" Value="140" />
    </Style>
    <Style Selector="Border.value-box">
        <Setter Property="Background" Value="#1A1A1D" />
        <Setter Property="BorderBrush" Value="#3A3A40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="Border.value-box TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.axes">
        <Setter Property="ColumnSpacing" Value="3" />
    </Style>
    <!-- Each axis box has a colored marker on its left: x red, y green, z blue. -->
    <Style Selector="Border.axis">
        <Setter Property="Padding" Value="0,0,5,0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.axis-marker">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="CornerRadius" Value="2,0,0,2" />
    </Style>
    <Style Selector="Border.axis-marker.axis-x">
        <Setter Property="Background" Value="#D9534F" />
    </Style>
    <Style Selector="Border.axis-marker.axis-y">
        <Setter Property="Background" Value="#5CB85C" />
    </Style>
    <Style Selector="Border.axis-marker.axis-z">
        <Setter Property="Background" Value="#4A90D9" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.badge.active">
        <Setter Property="Background" Value="#335CB85C" />
    </Style>
    <Style Selector="Border.badge.inactive">
        <Setter Property="Background" Value="#33A0A0A8" />
    </Style>
    <Style Selector="Border.badge.script">
        <Setter Property="Background" Value="#33E34234" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Border.badge.tag">
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style Selector="WrapPanel.tags">
        <Setter Property="Margin" Value="4,2" />
    </Style>
    <Style Selector="TextBlock.link">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorLight2}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Field editors: a box that edits looks like the read-only box, with the text box's chrome removed. -->
    <Style Selector="Border.value-box.editable">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.value-box.editable:pointerover">
        <Setter Property="BorderBrush" Value="#55555C" />
    </Style>
    <Style Selector="Border.value-box.axis.editable">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.value-edit">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.value-edit /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.value-edit:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#101012" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- An axis marker that edits is wide enough to drag. -->
    <Style Selector="Border.axis-marker.handle">
        <Setter Property="Width" Value="6" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ComboBox.value-choice">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="Button.field-button">
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#A0A0A8" />
    </Style>
    <Style Selector="Button.badge-button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.badge-button.active">
        <Setter Property="Background" Value="#335CB85C" />
    </Style>
    <Style Selector="Button.badge-button.inactive">
        <Setter Property="Background" Value="#33A0A0A8" />
    </Style>
    <Style Selector="TextBox.title-edit">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Border.problems">
        <Setter Property="Background" Value="#26E8B04A" />
        <Setter Property="BorderBrush" Value="#80E8B04A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="#E8B04A" />
    </Style>
    <Style Selector="Button.add-component">
        <Setter Property="Margin" Value="4,6" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.history">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.history ListBoxItem">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TextBlock.empty">
        <Setter Property="Foreground" Value="#808088" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="#808088" />
    </Style>

    <!-- Command palette -->
    <Style Selector="Border.palette">
        <Setter Property="Background" Value="#26262A" />
        <Setter Property="BorderBrush" Value="#3C3C42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #80000000" />
    </Style>
    <Style Selector="TextBox.palette-query">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ListBox.palette-results">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.palette-results ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Status bar -->
    <Style Selector="Border.status">
        <Setter Property="Background" Value="#1D1D20" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="BorderBrush" Value="#333337" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.status.playing">
        <Setter Property="Background" Value="#2E6B3A" />
    </Style>
    <Style Selector="Border.status.paused">
        <Setter Property="Background" Value="#7A5A1E" />
    </Style>
    <Style Selector="Border.viewport-frame">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.viewport-frame.playing">
        <Setter Property="BorderBrush" Value="#4CAF50" />
    </Style>
    <Style Selector="Border.viewport-frame.paused">
        <Setter Property="BorderBrush" Value="#E8B04A" />
    </Style>
    <Style Selector="Border.status TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- The viewport: a box selection being dragged, and the buttons of the tool palette. -->
    <Style Selector="Border.selection-box">
        <Setter Property="Background" Value="#22E34234" />
        <Setter Property="BorderBrush" Value="#E34234" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.outliner-toggle">
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.viewport-tool">
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
