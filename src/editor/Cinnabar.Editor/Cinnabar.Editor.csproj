<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>editor</AssemblyName>
    <RootNamespace>Cinnabar.Editor</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.Direct3D12" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cinnabar.Editor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cinnabar.Editor.Commands\Cinnabar.Editor.Commands.csproj" />
    <ProjectReference Include="..\Cinnabar.Editor.Content\Cinnabar.Editor.Content.csproj" />
    <ProjectReference Include="..\Cinnabar.Editor.Document\Cinnabar.Editor.Document.csproj" />
    <ProjectReference Include="..\Cinnabar.Editor.Link\Cinnabar.Editor.Link.csproj" />
    <ProjectReference Include="..\Cinnabar.Editor.Mesh\Cinnabar.Editor.Mesh.csproj" />
    <ProjectReference Include="..\Cinnabar.Editor.Model\Cinnabar.Editor.Model.csproj" />
    <ProjectReference Include="..\Cinnabar.Editor.Tools\Cinnabar.Editor.Tools.csproj" />
  </ItemGroup>
</Project>
