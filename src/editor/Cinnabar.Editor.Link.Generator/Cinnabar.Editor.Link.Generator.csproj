<Project Sdk="Microsoft.NET.Sdk">
  <!-- The source generator that turns the editor link's schema into C# (see docs/editor.md#editor-link). Roslyn
       loads generators as .NET Standard 2.0 assemblies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Cinnabar.Editor.Link.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Release tracking is for analyzers shipped as packages. This one only builds the editor. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
