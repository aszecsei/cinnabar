@(private = "file")
expect_rgba :: proc(t: ^testing.T, name: string, data: []u8) {
	image, err := decode_tiff(data)
	testing.expectf(t, err == "", "%s: %s", name, err)
	if err != "" {
		return
	}
	testing.expect_value(t, image.width, 7)
	testing.expect_value(t, image.height, 5)
	testing.expect(t, !image.linear)
	for y in 0 ..< 5 {
		for x in 0 ..< 7 {
			want := [4]f32{f32((x * 37 + y * 11) % 256), f32((x * 5 + y * 60) % 256), f32((255 - x * 30) % 256), f32((y * 50 + x) % 256)} / 255
			got := image.pixels[y * 7 + x]
			if got != want {
				testing.expectf(t, false, "%s: pixel %d,%d is %v, not %v", name, x, y, got, want)
				return
			}
		}
	}
}

@(test)
tiffs_decode_in_each_compression :: proc(t: ^testing.T) {
	expect_rgba(t, "uncompressed", TIFF_RGBA_NONE[:])
	expect_rgba(t, "PackBits", TIFF_RGBA_PACKBITS[:])
	expect_rgba(t, "LZW", TIFF_RGBA_LZW[:])
	expect_rgba(t, "Deflate", TIFF_RGBA_DEFLATE[:])
	expect_rgba(t, "LZW with the predictor", TIFF_RGBA_LZW_PREDICTOR[:])
}

@(test)
tiffs_decode_16_bit_gray_and_floats :: proc(t: ^testing.T) {
	gray, gray_err := decode_tiff(TIFF_GRAY16[:])
	testing.expect_value(t, gray_err, "")
	if gray_err == "" {
		for y in 0 ..< 5 {
			for x in 0 ..< 7 {
				v := f32(x * 9000 + y * 700) / 65535
				testing.expect_value(t, gray.pixels[y * 7 + x], [4]f32{v, v, v, 1})
			}
		}
	}
	floats, float_err := decode_tiff(TIFF_FLOAT[:])
	testing.expect_value(t, float_err, "")
	if float_err == "" {
		testing.expect(t, floats.linear)
		v := f32(6) * 0.5 + f32(4) * 2.25
		testing.expect_value(t, floats.pixels[4 * 7 + 6], [4]f32{v, v, v, 1})
	}
}

@(test)
broken_tiffs_say_why :: proc(t: ^testing.T) {
	_, not_tiff := decode_tiff([]u8{'P', 'N', 'G', 0, 0, 0, 0, 0})
	testing.expect_value(t, not_tiff, "is not a TIFF")
	cut := TIFF_RGBA_NONE
	_, short := decode_tiff(cut[:len(cut) - 120])
	testing.expect(t, short != "")
}
