# nodes: 1 16 3 4
# A comment and a blank line can come before the header.

animation_graph 1 # and after it
entry=first
entry = idle
root_motion = "not this one"
root_motion = "b_#Root" # a hash in quotes is no comment
param speed float

clip a = $00112233445566778899AABBCCDDEEFF
	# A comment and a blank line under a clip stay in it, as the event below follows them.

	event 0.5 step "a \" # b" 1
clip b = $ffeeddccbbaa99887766554433221100
node 1 state
	name=idle
	# The same under a node.

	motion = a
# This comment does not end the node above: a line indented after it would be the node's.
node 0x10 state
	name = move
	motion = @4.pose
node 3 transition
	from = idle
	to = move
	when = speed > 1
node 4 blend_1d
	parameter = speed
	input.0 = a
	at.0 = 0
	input.1 = b
	at.1 = 1
