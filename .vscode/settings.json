{
	// luau-lsp for the game's scripts (see docs/scripting.md#types-and-tooling). `just script-types` writes the
	// definition file. The old type solver matches the one that tools/cook checks with.
	"luau-lsp.platform.type": "standard",
	"luau-lsp.types.definitionFiles": {
		"@cinnabar": "build/script-types/cinnabar.d.luau"
	},
	"luau-lsp.fflags.override": {
		"LuauSolverV2": "false"
	},
	"luau-lsp.sourcemap.enabled": false
}
